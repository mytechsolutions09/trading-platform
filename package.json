{
  "name": "trading-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx server/index.ts",
    "dev:cf": "npx wrangler dev server/cf-worker.ts --port 8787",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "deploy:cf": "npx wrangler deploy server/cf-worker.ts",
    "d1:migrate:local": "npx wrangler d1 migrations apply DB --local",
    "d1:migrate:prod": "npx wrangler d1 migrations apply DB --remote",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:path": "node -e \"console.log(require('path').resolve('data/apex-trade.db'))\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^3.114.0"
  }
}
